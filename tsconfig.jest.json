{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node", 
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["jest", "node"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.vue",
    "src/assets/tests/unit/**/*.spec.ts",
    "src/assets/tests/unit/**/*.test.ts"
  ]
}